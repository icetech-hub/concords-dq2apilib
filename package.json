{
  "name": "concords-dq2apilib",
  "version": "3.0.0",
  "description": "DQ2 WebAssembly API Library - 行情與交易資料 API",
  "type": "module",
  "main": "dist/cjs/dq2api.js",
  "module": "dist/esm/dq2api.js",
  "types": "dist/esm/dq2api.d.ts",
  "jsdelivr": "dist/dq2apilib.js",
  "unpkg": "dist/dq2apilib.js",
  "exports": {
    ".": {
      "types": "./dist/esm/dq2api.d.ts",
      "import": "./dist/esm/dq2api.js",
      "require": "./dist/cjs/dq2api.js",
      "default": "./dist/esm/dq2api.js"
    },
    "./wasm": {
      "default": "./dist/dq2apilib.js"
    }
  },
  "files": [
    "dist/dq2apilib.js",
    "dist/dq2apilib.js.map",
    "dist/FeedAPI_pb.js",
    "dist/FeedAPI.js",
    "dist/FeedAPI.proto",
    "dist/HDAPI_pb.js",
    "dist/HDAPI.js",
    "dist/HDAPI.proto",
    "dist/quote2_pb.js",
    "dist/quote2.js",
    "dist/quote2.proto",
    "dist/cjs/",
    "dist/esm/",
    "README.md"
  ],
  "keywords": [
    "dq2",
    "trading",
    "quote",
    "nats",
    "market-data",
    "futures",
    "stock"
  ],
  "author": "aaron",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/icetech-hub/concords-dq2apilib.git"
  },
  "bugs": {
    "url": "https://github.com/icetech-hub/concords-dq2apilib/issues"
  },
  "homepage": "https://github.com/icetech-hub/concords-dq2apilib#readme",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  }
}
